# Vantik Analytics — konfigurasi production.
# Salin menjadi `.env` di direktori aplikasi, lalu isi nilainya.

NODE_ENV=production

# WAJIB. Kunci enkripsi secrets vault (SECURITY.md Bagian 6).
# Bangkitkan dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kehilangan kunci ini = kredensial Koneksi Eksternal tidak dapat didekripsi lagi.
VANTIK_MASTER_KEY=

# Direktori basis data. WAJIB di luar document root.
# Default relatif terhadap direktori aplikasi; pada cPanel biasanya cukup seperti ini.
VANTIK_DATA_DIR=../vantik-data

# Rahasia verifikasi tanda tangan webhook payment gateway (SECURITY.md 16.3).
# Kosongkan bila belum memakai payment gateway.
VANTIK_PAYMENT_WEBHOOK_SECRET=

# Paksa driver SQLite tertentu. Biarkan kosong agar dipilih otomatis:
# better-sqlite3 bila terpasang, jika tidak node:sqlite bawaan Node.
# Nilai yang sah: better-sqlite3 | node:sqlite
VANTIK_SQLITE_DRIVER=

# PORT diisi otomatis oleh Passenger; hanya perlu diisi pada VPS.
# PORT=4000

# ─────────────────────────────────────────────────────────────────────────────
# Penjadwal (opsional, TETAPI dianjurkan di shared hosting)
#
# Passenger mematikan proses yang idle, jadi ticker dalam proses berhenti bersama
# prosesnya: situs yang sepi tidak akan mengevaluasi ambang batas KPI maupun mengirim
# laporan terjadwal. Bila hosting Anda punya cron, isi token di bawah lalu panggil
# endpoint pemicu secara berkala:
#
#   */10 * * * * curl -fsS -X POST https://analitik.contoh.id/api/v1/system/scheduler/run \
#                  -H "X-Vantik-Scheduler-Token: $VANTIK_SCHEDULER_TOKEN" >/dev/null
#
# Tanpa token ini, endpoint pemicu MENOLAK semua permintaan (fail secure) dan
# penjadwalan hanya berjalan selama ada proses yang hidup.
# Hasilkan dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VANTIK_SCHEDULER_TOKEN=
