# Vantik Analytics — konfigurasi production.
# Salin menjadi `.env` di direktori aplikasi, lalu isi nilainya.

NODE_ENV=production

# WAJIB. Kunci enkripsi secrets vault (SECURITY.md Bagian 6).
# Bangkitkan dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kehilangan kunci ini = kredensial Koneksi Eksternal tidak dapat didekripsi lagi.
VANTIK_MASTER_KEY=

# Direktori basis data. WAJIB di luar document root.
# Default relatif terhadap direktori aplikasi; pada cPanel biasanya cukup seperti ini.
VANTIK_DATA_DIR=../vantik-data

# Rahasia verifikasi tanda tangan webhook payment gateway (SECURITY.md 16.3).
#
# Dibiarkan kosong berarti webhook-nya MENOLAK semua pemberitahuan pembayaran — itu memang
# yang benar: tanda tangan yang sah untuk rahasia kosong dapat dihitung siapa pun. Selama
# kosong, pembayaran dicatat operator lewat Manajemen Tenant → Faktur menunggu pembayaran
# (izin `billing:settle`; lihat panduan §8.1f).
#
# Pelanggan TIDAK dapat menyatakan pembayarannya sendiri — tombol di halaman Langganan hanya
# menerbitkan faktur.
VANTIK_PAYMENT_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Payment gateway — KOSONG secara bawaan, isi sendiri. Lihat panduan §8.1g.
#
# Bila diisi, tombol di halaman Langganan menghasilkan TAUTAN PEMBAYARAN: halaman milik
# penyedia yang menampilkan QRIS, virtual account, dan e-wallet. Pelanggan membayar di sana,
# penyedia mengabari sistem, dan ruang kerja terbuka otomatis.
#
# Selama kosong, pembayaran dicatat operator secara manual (§8.1f) — tidak ada yang rusak.
# Kanal aktif hanya bila PROVIDER dan SECRET_KEY terisi; setengah terkonfigurasi tidak
# diaktifkan.
#
# Jangan lupa daftarkan URL kabar pembayaran di dasbor penyedia:
#   https://analitik.contoh.id/webhooks/payment
#
# Nilai yang sah: xendit | midtrans
VANTIK_PAYMENT_PROVIDER=

# Xendit: Secret API Key. Midtrans: Server Key. Kunci ini dapat membuat tagihan atas nama
# Anda — ia tidak pernah dikembalikan lewat API mana pun dan tidak pernah masuk pesan
# kesalahan, tetapi tetap perlakukan seperti kata sandi.
VANTIK_PAYMENT_SECRET_KEY=

# WAJIB untuk Xendit: Callback Verification Token dari Settings → Webhooks.
# Selama kosong, SELURUH kabar pembayaran Xendit DITOLAK — itu memang yang benar, karena
# tanpa token tidak ada cara membuktikan kabarnya asli.
# Midtrans tidak memakainya (ia men-hash badan pesan dengan Server Key); biarkan kosong.
VANTIK_PAYMENT_CALLBACK_TOKEN=

# Isi untuk memakai lingkungan sandbox penyedia, mis.
#   Xendit   : https://api.xendit.co  (sama; bedakan lewat kunci development)
#   Midtrans : https://app.sandbox.midtrans.com
# VANTIK_PAYMENT_API_BASE=

# Tujuan setelah pembayaran selesai / dibatalkan. Kosong = halaman bawaan penyedia.
# VANTIK_PAYMENT_SUCCESS_URL=https://analitik.contoh.id/#/subscription
# VANTIK_PAYMENT_FAILURE_URL=https://analitik.contoh.id/#/subscription

# Paksa driver SQLite tertentu. Biarkan kosong agar dipilih otomatis:
# better-sqlite3 bila terpasang, jika tidak node:sqlite bawaan Node.
# Nilai yang sah: better-sqlite3 | node:sqlite
VANTIK_SQLITE_DRIVER=

# PORT diisi otomatis oleh Passenger; hanya perlu diisi pada VPS.
# PORT=4000

# ─────────────────────────────────────────────────────────────────────────────
# Penjadwal (opsional, TETAPI dianjurkan di shared hosting)
#
# Passenger mematikan proses yang idle, jadi ticker dalam proses berhenti bersama
# prosesnya: situs yang sepi tidak akan mengevaluasi ambang batas KPI maupun mengirim
# laporan terjadwal. Bila hosting Anda punya cron, isi token di bawah lalu panggil
# endpoint pemicu secara berkala:
#
#   */10 * * * * curl -fsS -X POST https://analitik.contoh.id/api/v1/system/scheduler/run \
#                  -H "X-Vantik-Scheduler-Token: $VANTIK_SCHEDULER_TOKEN" >/dev/null
#
# Tanpa token ini, endpoint pemicu MENOLAK semua permintaan (fail secure) dan
# penjadwalan hanya berjalan selama ada proses yang hidup.
# Hasilkan dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VANTIK_SCHEDULER_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Pendaftaran mandiri (halaman depan → "Berlangganan")
#
# Menyala secara bawaan: pengunjung dapat memilih paket dan mendaftar. Pendaftarannya
# MENUNGGU PERSETUJUAN admin, dan ruang kerjanya belum dapat menulis sampai pembayaran
# pertama tercatat (uji coba gratis mati — lihat di bawah). Setiap pendaftaran yang berhasil
# MEMBUAT TENANT, jadi jalurnya dibatasi ketat (3 per jam per alamat IP).
#
# Setel `off` untuk pemasangan internal yang penggunanya dibuat administrator — halaman
# depan ikut menyembunyikan ajakan mendaftar, sehingga tidak ada tombol yang mengarah
# ke penolakan.
VANTIK_SELF_SIGNUP=on

# --- Uji coba gratis: MATI secara bawaan.
#
# Ruang kerja baru tidak mendapat masa pakai gratis. Alasannya komersial: pendaftaran
# mandiri yang menghadiahkan masa pakai penuh dapat diulang dengan alamat email baru.
#
# Ruang kerja baru dapat DIMASUKI dan DIBACA setelah disetujui admin, tetapi penulisannya
# terbuka hanya setelah pembayaran pertama tercatat. Dua gerbang itu berdiri sendiri.
#
# Isi jumlah HARI bila memang ingin menawarkan uji coba, mis. 14. Kosong atau 0 = tidak ada
# uji coba. Nilai yang tidak dapat dibaca sebagai angka diabaikan.
VANTIK_TRIAL_DAYS=0

# ─────────────────────────────────────────────────────────────────────────────
# Retensi: pemangkasan tabel yang terus tumbuh
#
# Beberapa tabel bertambah pada setiap pemakaian dan tidak pernah menyusut sendiri.
# Pekerjaan `retention.prune` berjalan bersama penjadwal dan membuangnya. Angka bawaan
# di bawah sudah wajar — SELURUH baris ini dapat dibiarkan berkomentar.
#
# Satuannya HARI. Nilai `0` mematikan pemangkasan tabel tersebut. Nilai yang tidak dapat
# dibaca sebagai angka DIABAIKAN dan bawaan tetap dipakai, supaya salah ketik di berkas
# ini tidak berarti "pangkas sesudah NaN hari".
#
# Tiga hal yang TIDAK PERNAH dipangkas apa pun setelannya:
#   - sesi yang masih hidup (mengeluarkan orang demi ruang disk = kerusakan);
#   - pesan outbox `queued`/`failed` (satu-satunya salinan kode pemulihan & OTP selama
#     kredensial SMTP di bawah belum diisi);
#   - audit_log & usage_events (append-only lewat trigger — lihat panduan §9b).
#
# VANTIK_RETAIN_LOGIN_ATTEMPTS_DAYS=90
# VANTIK_RETAIN_DEAD_SESSIONS_DAYS=30
# VANTIK_RETAIN_MFA_CHALLENGES_DAYS=30
# VANTIK_RETAIN_PASSWORD_RESETS_DAYS=30
# VANTIK_RETAIN_EMBED_REQUESTS_DAYS=365
# VANTIK_RETAIN_SENSOR_READINGS_DAYS=90
# VANTIK_RETAIN_SENT_NOTIFICATIONS_DAYS=30
# VANTIK_RETAIN_ANALYSIS_CACHE_DAYS=30
# VANTIK_RETAIN_SCHEDULER_RUNS_DAYS=30

# ─────────────────────────────────────────────────────────────────────────────
# Pengiriman notifikasi — SEMUA DIBIARKAN KOSONG, isi sendiri.
#
# Tiga kanal sudah terpasang di kode: email (SMTP), WhatsApp, dan Telegram. Selama nilainya
# kosong, aplikasi TIDAK berpura-pura mengirim: pesan tetap berstatus `queued` di
# `GET /api/v1/notifications/outbox`, bukan `delivered`. Itu disengaja — "tercatat terkirim"
# yang salah lebih berbahaya daripada kegagalan yang terlihat, terutama untuk OTP dan kode
# pemulihan kata sandi.
#
# Sebuah kanal hanya menyala bila SELURUH nilai wajibnya terisi. Konfigurasi setengah jadi
# tidak diaktifkan, supaya tidak menghasilkan pesan `failed` yang membingungkan.
#
# Konfigurasi dibaca sekali saat proses menyala: RESTART aplikasi setelah mengisi.
# Kanal mana yang hidup dapat diperiksa di `GET /api/v1/system/notification-channels`
# (nama kanal saja — tanpa host, pengirim, atau token).
#
# Antrean yang sudah menumpuk ikut terkirim setelah restart. Pesan yang gagal dicoba sampai
# 5 kali lalu ditandai `failed`; kanal yang belum diisi DILEWATI tanpa memakai percobaannya.
# Sapuan penyusulnya berjalan bersama penjadwal — lihat VANTIK_SCHEDULER_TOKEN di atas.

# --- Email (SMTP). Wajib: HOST + FROM. Ini kanal terpenting: OTP pemindahan perangkat dan
# --- kode pemulihan kata sandi lewat di sini.
# Nilai host/port biasanya ada di cPanel → Email Accounts → Connect Devices.
VANTIK_SMTP_HOST=
VANTIK_SMTP_PORT=587
VANTIK_SMTP_USER=
VANTIK_SMTP_PASSWORD=
VANTIK_SMTP_FROM=

# Kosongkan agar diturunkan dari port (465 → TLS langsung, 587 → STARTTLS).
# Isi `true`/`false` hanya untuk host yang tidak lazim.
# VANTIK_SMTP_IMPLICIT_TLS=

# TIDAK ADA mode tanpa enkripsi: bila server pada port 587 tidak menawarkan STARTTLS,
# pengiriman dibatalkan (`server_without_starttls`) alih-alih mengirim kata sandi dan kode
# pemulihan dalam bentuk polos.
#
# Setel `true` HANYA bila hosting menyajikan sertifikat mail yang tidak cocok dengan nama
# host-nya. Menyalakannya berarti menerima lalu lintas dapat disadap pihak yang mampu
# menyisipkan diri — termasuk isi OTP. Biarkan mati bila pengiriman sudah berhasil.
# VANTIK_SMTP_ALLOW_INSECURE_TLS=false

# --- Telegram. Wajib: BOT_TOKEN. Penerima adalah chat id, BUKAN nomor telepon; pengguna
# --- harus menekan Start pada bot lebih dulu.
VANTIK_TELEGRAM_BOT_TOKEN=
# VANTIK_TELEGRAM_API_BASE=https://api.telegram.org

# --- WhatsApp. Wajib: URL.
#
# Berbentuk template, bukan bentuk milik satu penyedia — "API WhatsApp" bukan satu hal:
# WhatsApp Cloud API milik Meta, Fonnte, Wablas, dan Twilio berbeda bentuk badannya.
# Placeholder: {{recipient}}, {{subject}}, {{body}} — ketiganya disisipkan sebagai string
# JSON yang sudah di-escape, jadi tanda kutip di dalam pesan tidak merusak badan permintaan.
VANTIK_WHATSAPP_URL=
# Bila diisi, dikirim sebagai header `Authorization: Bearer <token>`.
VANTIK_WHATSAPP_TOKEN=
# VANTIK_WHATSAPP_METHOD=POST
# Objek JSON satu baris untuk header non-standar, mis. {"X-Api-Key":"..."}
# VANTIK_WHATSAPP_HEADERS=
#
# Bawaannya bentuk WhatsApp Cloud API. Contoh penyedia lokal bergaya sederhana:
# VANTIK_WHATSAPP_BODY_TEMPLATE={"target":"{{recipient}}","message":"{{subject}}\n{{body}}"}
# VANTIK_WHATSAPP_BODY_TEMPLATE=
