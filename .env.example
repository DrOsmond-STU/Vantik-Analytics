# Kunci enkripsi utama (32 byte hex/base64) untuk secrets vault — SECURITY.md Bagian 6.
# WAJIB diset di production; di development kunci acak dibangkitkan per proses.
VANTIK_MASTER_KEY=

# Direktori basis data (main, audit, vault berada di berkas terpisah).
VANTIK_DATA_DIR=./.data

# Rahasia verifikasi tanda tangan webhook payment gateway — SECURITY.md 16.3.
VANTIK_PAYMENT_WEBHOOK_SECRET=

# Payment gateway — kosong secara bawaan; lihat docs/DEPLOY-SHARED-HOSTING.md §8.1g.
# Bila diisi, faktur mendapat tautan bayar (QRIS/VA/e-wallet) dan ruang kerja terbuka
# otomatis setelah pembayaran dikonfirmasi. Nilai yang sah: xendit | midtrans
VANTIK_PAYMENT_PROVIDER=
VANTIK_PAYMENT_SECRET_KEY=
VANTIK_PAYMENT_CALLBACK_TOKEN=

PORT=4000
NODE_ENV=development

# Uji coba gratis untuk tenant baru, dalam HARI. Kosong atau 0 = tidak ada uji coba
# (bawaan). Ruang kerja baru dapat dibaca tetapi belum dapat menulis sampai pembayaran
# pertama tercatat — lihat docs/DEPLOY-SHARED-HOSTING.md §8.1e.
VANTIK_TRIAL_DAYS=0

# Pengiriman notifikasi — kosong secara bawaan; lihat docs/DEPLOY-SHARED-HOSTING.md §8.3.
# Selama kosong, pesan diantre tanpa dikirim (status tetap `queued`, bukan `delivered`) —
# itu disengaja: "tercatat terkirim" yang salah lebih berbahaya untuk OTP dan kode pemulihan
# daripada kegagalan yang terlihat. Kanal hanya menyala bila nilai wajibnya lengkap.
VANTIK_SMTP_HOST=
VANTIK_SMTP_PORT=587
VANTIK_SMTP_USER=
VANTIK_SMTP_PASSWORD=
VANTIK_SMTP_FROM=
VANTIK_TELEGRAM_BOT_TOKEN=
VANTIK_WHATSAPP_URL=
VANTIK_WHATSAPP_TOKEN=
